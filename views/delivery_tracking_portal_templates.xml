            <xpath expr="//tr/td[last()]" position="after">
                <td class="text-end">
                    <t t-set="picking_order_track"
                       t-value="request.env['stock.picking'].sudo().search([('sale_id', '=', order.id), ('picking_type_code', '=', 'outgoing'), '|', ('carrier_tracking_ref', '!=', False), ('carrier_tracking_ref_2', '!=', False)], limit=1)"/>
