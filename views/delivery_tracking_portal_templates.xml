                           t-att-href="'/my/orders/%s/tracking' % order.id" class="me-1">Kurir 1</a>
                        <a t-if="picking_order_track.carrier_tracking_ref_2"
                           t-att-href="'/my/orders/%s/tracking?carrier=2' % order.id" class="badge text-bg-light border text-decoration-none">Kurir 2</a>
                    </t>
                    <span t-else="" class="text-muted">—</span>
                </td>
            </xpath>
        </field>
    </record>

