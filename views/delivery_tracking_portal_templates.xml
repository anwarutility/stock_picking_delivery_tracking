<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         CUSTOMER TRACKING PAGE (UI/UX Pro Max - Dual Web & Mobile)
         Shared by both access paths:
         - logged-in portal users (/my/orders/<id>/tracking)
         - public token link      (/tracking/<token>)
         Features:
         - Dual View Modes: Responsive Desktop Web & Mobile Smartphone Simulator
         - Ambient Status Hero Card with Dynamic Route Visualizer
         - Animated Moving Delivery Truck marker on route bar
         - 6-Stage Stepper Milestones with Glow Indicators
         - Live Checkpoint Vertical Timeline with Radar Pulse
         - Carrier Brand Styling (J&T Cargo, JNE, SiCepat, etc.)
         - 1-Click Resi & Link Copy with Instant Feedback
         - WhatsApp Direct Sharing & Customer Support Chat
         - Package Items (Daftar Barang) Collapsible Accordion
         - Mobile Bottom Sticky Bar for Ultra-Comfortable Thumb Reach
         ========================================================= -->
    <template id="portal_tracking_page" name="Delivery Order Tracking Page">
        <t t-call="portal.portal_layout">
            <div t-attf-class="o_dtd_page {{is_public and 'o_dtd_public_view' or ''}}" id="dtd_root" t-att-data-company="origin_info['name']">

                <!-- TOP GLASSMORPHISM BAR: TRUST BADGE & VIEW MODE SWITCHER -->
                <header class="o_dtd_top_bar" role="banner">
                    <div class="o_dtd_top_bar_inner">
                        <div class="o_dtd_brand_left">
                            <span class="o_dtd_badge_verified" role="status" aria-label="Resmi Terverifikasi">
                                <i class="fa fa-shield" aria-hidden="true"/>
                                <span>Resmi &amp; Terverifikasi</span>
                            </span>
                            <span class="o_dtd_brand_company d-none d-md-inline">
                                <t t-out="origin_info['name']"/>
                            </span>
                        </div>

                        <!-- Web vs Mobile Switcher (Desktop Preview Simulator) -->
                        <div class="o_dtd_mode_switcher" role="group" aria-label="Mode Tampilan">
                            <button type="button" class="o_dtd_mode_btn is-active" id="btn_dtd_web" onclick="dtdSetViewMode('web')" aria-pressed="true" title="Tampilan penuh untuk Layar Laptop / Komputer">
                                <i class="fa fa-desktop" aria-hidden="true"/>
                                <span>Tampilan Web</span>
                            </button>
                            <button type="button" class="o_dtd_mode_btn" id="btn_dtd_mobile" onclick="dtdSetViewMode('mobile')" aria-pressed="false" title="Simulasi Tampilan Layar Smartphone / Handphone">
                                <i class="fa fa-mobile" aria-hidden="true"/>
                                <span>Tampilan Mobile</span>
                            </button>
                        </div>
                    </div>
                </header>

                <!-- MAIN WRAPPER (Switches between Desktop widescreen grid and Smartphone mockup frame) -->
                <main class="o_dtd_layout_wrap mode-web" id="dtd_layout_wrap" role="main">

                    <!-- BRAND HEADER CARD -->
                    <section class="o_dtd_card o_dtd_brand_card" aria-label="Informasi Dokumen Pengiriman">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="o_dtd_brand_logo_box">
                                    <i class="fa fa-truck" aria-hidden="true"/>
                                </div>
                                <div>
                                    <div class="o_dtd_brand_title">
                                        <span>Lacak Pengiriman Pesanan</span>
                                        <span t-if="carrier_label" class="badge bg-secondary ms-2 small" t-out="carrier_label"/>
                                    </div>
                                    <div class="o_dtd_order_sub">
                                        No. Dokumen: <strong class="text-dark" t-out="picking_name"/>
                                        <span t-if="order_reference" class="ms-2 text-muted">
                                            (Ref: <strong class="text-primary" t-out="order_reference"/>)
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <span t-if="is_public" class="badge o_dtd_badge_subtle">
                                    <i class="fa fa-globe text-primary me-1" aria-hidden="true"/> Portal Publik Resmi
                                </span>
                                <span t-else="" class="badge o_dtd_badge_subtle">
                                    <i class="fa fa-user text-primary me-1" aria-hidden="true"/> <t t-out="partner_name"/>
                                </span>
                            </div>
                        </div>
                    </section>

                    <!-- MULTI-COURIER SEGMENTED TABS (IF SHIPMENT HAS MULTIPLE COURIERS) -->
                    <nav t-if="courier_tabs and len(courier_tabs) &gt; 1" class="o_dtd_courier_segmented" aria-label="Pilih Kurir Pengiriman">
                        <t t-foreach="courier_tabs" t-as="ct">
                            <a t-att-href="ct['is_active'] and '#' or ct['url']"
                               t-attf-class="o_dtd_courier_seg_item {{ct['is_active'] and 'is-active' or ''}}"
                               t-att-aria-current="ct['is_active'] and 'page' or 'false'">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="o_dtd_seg_tag"><t t-out="ct['label']"/></span>
                                    <i t-if="ct['is_active']" class="fa fa-check-circle text-primary" aria-hidden="true"/>
                                </div>
                                <span class="o_dtd_seg_name"><t t-out="ct['name']"/></span>
                                <span class="o_dtd_seg_resi">
                                    <i class="fa fa-barcode me-1 text-muted" aria-hidden="true"/>
                                    <t t-out="ct['resi'] or 'Resi belum diinput'"/>
                                </span>
                            </a>
                        </t>
                    </nav>

                    <!-- EXCEPTION BANNER -->
                    <div t-if="exception" class="alert alert-danger o_dtd_alert_card mb-3" role="alert">
                        <div class="d-flex align-items-start gap-3">
                            <div class="o_dtd_alert_icon text-danger">
                                <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                            </div>
                            <div>
                                <h6 class="mb-1 font-weight-bold">Pengiriman Mengalami Kendala</h6>
                                <p class="mb-1 small" t-if="exception['desc']" t-out="exception['desc']"/>
                                <p class="mb-1 small text-muted" t-if="exception['error']" t-out="exception['error']"/>
                                <p class="mb-0 small text-dark">
                                    Silakan hubungi tim layanan pelanggan kami untuk bantuan dan informasi terkini.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- UNKNOWN STATUS BANNER -->
                    <div t-if="unknown and not exception" class="alert alert-warning o_dtd_alert_card mb-3" role="status">
                        <div class="d-flex align-items-center gap-2 small">
                            <i class="fa fa-info-circle text-warning fs-5" aria-hidden="true"/>
                            <span>Status pengiriman sedang disinkronkan dengan server ekspedisi. Silakan muat ulang beberapa saat lagi.</span>
                        </div>
                    </div>

                    <!-- DASHBOARD CONTENT (2 Columns on Web, Stacked on Mobile) -->
                    <div class="o_dtd_dashboard_grid">

                        <!-- LEFT COLUMN: Status Hero, Route, Shipment Data & Package Items -->
                        <div class="o_dtd_col_left">

                            <!-- HERO STATUS & ROUTE CARD -->
                            <section t-attf-class="o_dtd_card o_dtd_hero_card status-tone-{{status_tone}}" aria-label="Status Pengiriman Terkini">
                                <!-- Status Header -->
                                <div class="o_dtd_hero_top">
                                    <div>
                                        <div class="o_dtd_hero_eyebrow">
                                            <span class="o_dtd_live_pulse_dot" aria-hidden="true"/>
                                            <span>STATUS PENGIRIMAN</span>
                                        </div>
                                        <div class="o_dtd_hero_headline">
                                            <span class="o_dtd_hero_icon">
                                                <i t-if="status == 'delivered'" class="fa fa-check-circle" aria-hidden="true"/>
                                                <i t-elif="status in ('shipped', 'in_transit')" class="fa fa-truck" aria-hidden="true"/>
                                                <i t-elif="status == 'exception'" class="fa fa-exclamation-circle" aria-hidden="true"/>
                                                <i t-else="" class="fa fa-clock-o" aria-hidden="true"/>
                                            </span>
                                            <span t-out="current_status['label']"/>
                                        </div>
                                        <p class="o_dtd_hero_desc mb-0" t-out="current_status['desc']"/>
                                    </div>
                                    <div class="text-end o_dtd_hero_eta_box">
                                        <div class="o_dtd_hero_eyebrow">PERKIRAAN TIBA (ETA)</div>
                                        <div class="o_dtd_hero_eta_val">
                                            <i class="fa fa-calendar-check-o text-primary" aria-hidden="true"/>
                                            <span t-out="eta_display or 'Sedang Diproses'"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- Dynamic Route Flow (Origin -> Moving Truck -> Destination) -->
                                <div class="o_dtd_route_card_inner">
                                    <div class="o_dtd_route_flow">
                                        <!-- Asal (Origin) -->
                                        <div class="o_dtd_route_point is-origin">
                                            <div class="o_dtd_point_icon">
                                                <i class="fa fa-building-o" aria-hidden="true"/>
                                            </div>
                                            <div class="o_dtd_point_body">
                                                <span class="o_dtd_point_role">Asal (Gudang Pengirim)</span>
                                                <strong class="o_dtd_point_name" t-out="origin_info['name']"/>
                                                <span class="o_dtd_point_loc">
                                                    <i class="fa fa-map-marker text-muted me-1" aria-hidden="true"/>
                                                    <t t-out="origin_info['city']"/>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Center Track with Animated Moving Van Marker -->
                                        <div class="o_dtd_route_line_wrap" aria-hidden="true">
                                            <div class="o_dtd_track_bg"/>
                                            <div class="o_dtd_track_fill" t-attf-style="width: {{route_progress_percent or 15}}%;"/>
                                            <div class="o_dtd_truck_marker" t-attf-style="left: {{route_progress_percent or 15}}%;" title="Posisi Paket">
                                                <i class="fa fa-truck" aria-hidden="true"/>
                                            </div>
                                        </div>

                                        <!-- Tujuan (Destination) -->
                                        <div class="o_dtd_route_point is-dest">
                                            <div class="o_dtd_point_icon">
                                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                            </div>
                                            <div class="o_dtd_point_body">
                                                <span class="o_dtd_point_role">Tujuan (Penerima Paket)</span>
                                                <strong class="o_dtd_point_name" t-out="dest_info['name']"/>
                                                <span class="o_dtd_point_loc">
                                                    <i class="fa fa-map-marker text-danger me-1" aria-hidden="true"/>
                                                    <t t-out="dest_info['location']"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <!-- SHIPMENT METADATA & RESI CARD -->
                            <section class="o_dtd_card o_dtd_data_card" aria-label="Detail Resi dan Ekspedisi">
                                <!-- Resi High-Visibility Banner -->
                                <div class="o_dtd_resi_hero_box">
                                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <div>
                                            <div class="o_dtd_meta_lbl">NOMOR RESI PENGIRIMAN</div>
                                            <div class="o_dtd_resi_num_wrap">
                                                <span class="o_dtd_resi_code" id="dtd_resi_text" t-out="resi or 'Belum tersedia'"/>
                                            </div>
                                        </div>
                                        <div>
                                            <button t-if="resi" type="button" class="o_dtd_btn_copy_large" id="dtd_copy_btn"
                                                    onclick="dtdCopyResi(this, 'dtd_resi_text')"
                                                    title="Salin nomor resi ke clipboard"
                                                    aria-label="Salin nomor resi">
                                                <i class="fa fa-copy" aria-hidden="true"/>
                                                <span class="copy-lbl">Salin No. Resi</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <!-- Key Metrics 2x2 Grid -->
                                <div class="o_dtd_meta_grid">
                                    <!-- Ekspedisi / Kurir -->
                                    <div class="o_dtd_meta_tile">
                                        <div class="o_dtd_meta_lbl">Ekspedisi Kurir</div>
                                        <div class="o_dtd_meta_val d-flex align-items-center gap-2">
                                            <span t-attf-class="o_dtd_courier_badge {{carrier_brand['brand_class']}}">
                                                <i class="fa fa-cube" aria-hidden="true"/>
                                                <t t-out="carrier_brand['badge_label']"/>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Penerima -->
                                    <div class="o_dtd_meta_tile">
                                        <div class="o_dtd_meta_lbl">Penerima Paket</div>
                                        <div class="o_dtd_meta_val text-truncate" title="Nama Penerima">
                                            <i class="fa fa-user-circle text-muted me-1" aria-hidden="true"/>
                                            <span t-out="dest_info['name']"/>
                                        </div>
                                    </div>

                                    <!-- Berat Kiriman -->
                                    <div class="o_dtd_meta_tile">
                                        <div class="o_dtd_meta_lbl">Berat Paket</div>
                                        <div class="o_dtd_meta_val">
                                            <i class="fa fa-balance-scale text-muted me-1" aria-hidden="true"/>
                                            <span t-out="weight_display or 'Standar'"/>
                                        </div>
                                    </div>

                                    <!-- Terakhir Diperbarui -->
                                    <div class="o_dtd_meta_tile">
                                        <div class="o_dtd_meta_lbl">Terakhir Diperbarui</div>
                                        <div class="o_dtd_meta_val small text-muted">
                                            <i class="fa fa-clock-o text-muted me-1" aria-hidden="true"/>
                                            <span t-out="last_check_display or 'Baru saja'"/>
                                        </div>
                                    </div>
                                </div>

                                <!-- QUICK ACTIONS TOOLBAR -->
                                <div class="o_dtd_quick_actions">
                                    <button type="button" class="o_dtd_action_btn o_btn_wa" onclick="dtdShareWhatsApp()"
                                            title="Bagikan link pelacakan paket via WhatsApp"
                                            aria-label="Bagikan link tracking via WhatsApp">
                                        <i class="fa fa-whatsapp" aria-hidden="true"/>
                                        <span>Bagikan ke WhatsApp</span>
                                    </button>
                                    <button type="button" class="o_dtd_action_btn" onclick="dtdCopyLink(this)"
                                            title="Salin link tracking ini"
                                            aria-label="Salin link tracking ini">
                                        <i class="fa fa-link text-primary" aria-hidden="true"/>
                                        <span class="link-lbl">Salin Link</span>
                                    </button>
                                    <button type="button" class="o_dtd_action_btn" onclick="window.location.reload()"
                                            title="Muat ulang status tracking"
                                            aria-label="Muat ulang status tracking">
                                        <i class="fa fa-refresh text-secondary" aria-hidden="true"/>
                                        <span>Segarkan</span>
                                    </button>
                                </div>
                            </section>

                            <!-- PACKAGE ITEMS (DAFTAR BARANG) CARD (IF ANY) -->
                            <section t-if="package_items" class="o_dtd_card o_dtd_items_card" aria-label="Daftar Barang Dikirim">
                                <div class="d-flex justify-content-between align-items-center cursor-pointer" onclick="dtdToggleItems()" id="dtd_items_toggle">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="o_dtd_items_icon">
                                            <i class="fa fa-cubes text-primary" aria-hidden="true"/>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">Daftar Barang dalam Paket</div>
                                            <div class="text-muted small"><t t-out="len(package_items)"/> jenis item terdaftar</div>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-light rounded-circle" aria-label="Buka/Tutup daftar barang">
                                        <i class="fa fa-chevron-down text-muted" id="dtd_items_chevron" aria-hidden="true"/>
                                    </button>
                                </div>

                                <div class="o_dtd_items_list mt-3" id="dtd_items_container">
                                    <ul class="list-unstyled mb-0">
                                        <t t-foreach="package_items" t-as="item">
                                            <li class="o_dtd_item_row">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="o_dtd_item_name text-dark font-weight-500" t-out="item['name']"/>
                                                    <span class="badge bg-light text-dark border ms-2">
                                                        <t t-out="item['qty']"/> <t t-out="item['uom']"/>
                                                    </span>
                                                </div>
                                            </li>
                                        </t>
                                    </ul>
                                </div>
                            </section>

                            <!-- CUSTOMER SUPPORT HELP CARD -->
                            <section class="o_dtd_card o_dtd_support_card" aria-label="Bantuan Layanan Pelanggan">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="o_dtd_support_avatar">
                                            <i class="fa fa-headphones" aria-hidden="true"/>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">Butuh Bantuan Paket Anda?</div>
                                            <div class="text-muted small">Tim Customer Care kami siap membantu pengecekan langsung.</div>
                                        </div>
                                    </div>
                                    <div>
                                        <a t-if="company_wa_phone or company_phone"
                                           t-attf-href="https://wa.me/{{company_wa_phone or company_phone.replace(' ', '').replace('-', '').replace('+', '').replace('(', '').replace(')', '')}}?text=Halo%20Admin%20{{(origin_info['name'] or 'CS').replace(' ', '%20')}},%20saya%20ingin%20bertanya%20mengenai%20status%20paket%20nomor%20{{resi or picking_name}}"
                                           target="_blank" rel="noopener noreferrer"
                                           class="btn btn-sm btn-success rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                            <i class="fa fa-whatsapp fs-6" aria-hidden="true"/>
                                            <span>Hubungi CS WhatsApp</span>
                                        </a>
                                        <a t-elif="company_email" t-attf-href="mailto:{{company_email}}"
                                           class="btn btn-sm btn-primary rounded-pill px-3 py-2 fw-bold d-inline-flex align-items-center gap-2">
                                            <i class="fa fa-envelope-o" aria-hidden="true"/>
                                            <span>Kirim Email CS</span>
                                        </a>
                                    </div>
                                </div>
                            </section>

                        </div>

                        <!-- RIGHT COLUMN: Stepper Milestones & Live Journey Timeline -->
                        <div class="o_dtd_col_right">

                            <!-- MILESTONE STEPPER PROGRESS BAR -->
                            <section class="o_dtd_card o_dtd_stepper_card" aria-label="Tahapan Milestone Pengiriman">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="o_dtd_meta_lbl">TAHAPAN PENGIRIMAN</span>
                                    <span class="small text-muted d-none d-sm-inline">
                                        <i class="fa fa-info-circle me-1" aria-hidden="true"/>Progres Real-Time
                                    </span>
                                </div>
                                <div class="o_dtd_stepper" role="list">
                                    <t t-foreach="steps" t-as="step">
                                        <div t-attf-class="o_dtd_step {{step['reached'] and 'is-done' or ''}} {{step['current'] and 'is-current' or ''}} {{step_last and 'is-last' or ''}}"
                                             role="listitem">
                                            <div class="o_dtd_step_icon">
                                                <i t-if="step['reached']" class="fa fa-check" aria-hidden="true"/>
                                                <i t-elif="step['current']" class="fa fa-circle" aria-hidden="true"/>
                                                <i t-else="" class="fa fa-circle-o" aria-hidden="true"/>
                                            </div>
                                            <div class="o_dtd_step_label" t-out="step['label']"/>
                                            <div class="o_dtd_step_ts" t-if="step['ts_display']" t-out="step['ts_display']"/>
                                        </div>
                                    </t>
                                </div>
                            </section>

                            <!-- LIVE TRACKING JOURNEY TIMELINE (VERTICAL CHECKPOINTS) -->
                            <section class="o_dtd_card o_dtd_journey_card" aria-label="Riwayat Perjalanan Paket">
                                <div class="o_dtd_journey_header">
                                    <div class="o_dtd_journey_title">
                                        <span class="o_dtd_journey_icon">
                                            <i class="fa fa-map-signs" aria-hidden="true"/>
                                        </span>
                                        <span>Detail Riwayat Perjalanan</span>
                                    </div>
                                    <div class="o_dtd_live_pill" role="status" aria-label="Pembaruan Langsung">
                                        <span class="o_dtd_live_dot" aria-hidden="true"/>
                                        <span>Live Tracking</span>
                                    </div>
                                </div>

                                <!-- Vertical Timeline Scans -->
                                <div class="o_dtd_timeline" role="list">
                                    <t t-foreach="detailed_progress" t-as="event">
                                        <div t-attf-class="o_dtd_event_item {{event['is_latest'] and 'is-latest' or ''}}" role="listitem">
                                            <!-- Checkpoint Node (Beacon) -->
                                            <div class="o_dtd_event_node" aria-hidden="true">
                                                <i t-if="event.get('icon')" t-attf-class="fa {{event['icon']}} o_dtd_node_glyph" aria-hidden="true"/>
                                            </div>

                                            <!-- Content Box -->
                                            <div class="o_dtd_event_content">
                                                <div class="o_dtd_event_top">
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="o_dtd_event_title" t-out="event['title']"/>
                                                        <span t-if="event['is_latest']" class="badge bg-primary rounded-pill px-2 py-1 small">
                                                            Status Terkini
                                                        </span>
                                                    </div>
                                                    <span class="o_dtd_event_time">
                                                        <i class="fa fa-clock-o me-1 text-muted" aria-hidden="true"/>
                                                        <t t-out="event['time_display'] or event['ts_display']"/>
                                                        <span t-if="event['date_display']" class="text-muted ms-1">• <t t-out="event['date_display']"/></span>
                                                    </span>
                                                </div>

                                                <p class="o_dtd_event_desc mb-2" t-out="event['desc']"/>

                                                <div class="o_dtd_event_tags">
                                                    <span t-if="event['location']" class="o_dtd_tag">
                                                        <i class="fa fa-map-marker text-danger" aria-hidden="true"/>
                                                        <t t-out="event['location']"/>
                                                    </span>
                                                    <span class="o_dtd_tag">
                                                        <i class="fa fa-truck text-primary" aria-hidden="true"/>
                                                        <t t-out="event['courier_name']"/>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>

                            </section>
                        </div>

                    </div>

                    <!-- FOOTER ACTIONS (FOR LOGGED-IN PORTAL USER) -->
                    <footer class="mt-4 mb-2 text-center" t-if="not is_public">
                        <a href="/my/orders" class="btn btn-outline-secondary btn-sm px-4 rounded-pill">
                            <i class="fa fa-arrow-left me-1" aria-hidden="true"/> Kembali ke Daftar Pesanan
                        </a>
                    </footer>

                    <!-- PUBLIC TRACKING FOOTER -->
                    <footer class="o_dtd_public_footer text-center text-muted small mt-4 pt-3 border-top">
                        <p class="mb-1 font-weight-500">
                            Sistem Pelacakan Pengiriman Terintegrasi • <t t-out="origin_info['name']"/>
                        </p>
                        <p class="mb-0 text-secondary">
                            Data status otomatis diperbarui secara berkala dari sistem ekspedisi logistik.
                        </p>
                    </footer>

                </main>

                <!-- MOBILE BOTTOM STICKY ACTION BAR (VISIBLE ON SMARTPHONE) -->
                <nav class="o_dtd_mobile_bottom_bar d-md-none" aria-label="Aksi Cepat Mobile">
                    <div class="o_dtd_mobile_bar_inner">
                        <button t-if="resi" type="button" class="o_dtd_bar_btn o_btn_copy_bar" onclick="dtdCopyResi(this, 'dtd_resi_text')">
                            <i class="fa fa-copy" aria-hidden="true"/>
                            <span class="copy-lbl">Salin Resi</span>
                        </button>
                        <a t-if="company_wa_phone or company_phone"
                           t-attf-href="https://wa.me/{{company_wa_phone or company_phone.replace(' ', '').replace('-', '').replace('+', '').replace('(', '').replace(')', '')}}?text=Halo%20Admin%20{{(origin_info['name'] or 'CS').replace(' ', '%20')}},%20saya%20ingin%20tanya%20paket%20{{resi or picking_name}}"
                           target="_blank" rel="noopener noreferrer"
                           class="o_dtd_bar_btn o_btn_wa_bar">
                            <i class="fa fa-whatsapp" aria-hidden="true"/>
                            <span>Bantuan CS</span>
                        </a>
                        <a t-elif="company_email"
                           t-attf-href="mailto:{{company_email}}"
                           class="o_dtd_bar_btn o_btn_wa_bar">
                            <i class="fa fa-envelope-o" aria-hidden="true"/>
                            <span>Email CS</span>
                        </a>
                    </div>
                </nav>

            </div>

            <!-- INLINE JAVASCRIPT FOR VIEW SWITCHING, CLIPBOARD COPY, & SHARING -->
            <script type="text/javascript">
                function dtdSetViewMode(mode) {
                    var wrap = document.getElementById('dtd_layout_wrap');
                    var btnWeb = document.getElementById('btn_dtd_web');
                    var btnMobile = document.getElementById('btn_dtd_mobile');
                    if (!wrap) return;

                    if (mode === 'mobile') {
                        wrap.classList.add('mode-mobile-sim');
                        wrap.classList.remove('mode-web');
                        if (btnMobile) {
                            btnMobile.classList.add('is-active');
                            btnMobile.setAttribute('aria-pressed', 'true');
                        }
                        if (btnWeb) {
                            btnWeb.classList.remove('is-active');
                            btnWeb.setAttribute('aria-pressed', 'false');
                        }
                    } else {
                        wrap.classList.remove('mode-mobile-sim');
                        wrap.classList.add('mode-web');
                        if (btnWeb) {
                            btnWeb.classList.add('is-active');
                            btnWeb.setAttribute('aria-pressed', 'true');
                        }
                        if (btnMobile) {
                            btnMobile.classList.remove('is-active');
                            btnMobile.setAttribute('aria-pressed', 'false');
                        }
                    }
                }

                function dtdCopyResi(btn, elementId) {
                    var el = document.getElementById(elementId);
                    if (!el) return;
                    var text = el.innerText.trim();
                    if (!text || text === 'Belum tersedia') return;

                    dtdExecuteCopy(text, function() {
                        var lbl = btn.querySelector('.copy-lbl');
                        if (!lbl) return;
                        var orig = lbl.innerText;
                        lbl.innerText = 'Tersalin! ✓';
                        btn.classList.add('copied');
                        setTimeout(function() {
                            lbl.innerText = orig;
                            btn.classList.remove('copied');
                        }, 2000);
                    });
                }

                function dtdCopyLink(btn) {
                    var url = window.location.href;
                    dtdExecuteCopy(url, function() {
                        var lbl = btn.querySelector('.link-lbl');
                        if (!lbl) return;
                        var orig = lbl.innerText;
                        lbl.innerText = 'Link Tersalin! ✓';
                        btn.classList.add('copied');
                        setTimeout(function() {
                            lbl.innerText = orig;
                            btn.classList.remove('copied');
                        }, 2000);
                    });
                }

                function dtdExecuteCopy(text, callback) {
                    if (navigator.clipboard &amp;&amp; window.isSecureContext) {
                        navigator.clipboard.writeText(text).then(callback).catch(function() {
                            dtdFallbackCopy(text, callback);
                        });
                    } else {
                        dtdFallbackCopy(text, callback);
                    }
                }

                function dtdFallbackCopy(text, callback) {
                    var temp = document.createElement('textarea');
                    temp.value = text;
                    temp.style.position = 'fixed';
                    temp.style.left = '-9999px';
                    document.body.appendChild(temp);
                    temp.focus();
                    temp.select();
                    try {
                        document.execCommand('copy');
                        if (callback) callback();
                    } catch (err) {}
                    document.body.removeChild(temp);
                }

                function dtdShareWhatsApp() {
                    var resiEl = document.getElementById('dtd_resi_text');
                    var rootEl = document.getElementById('dtd_root');
                    var resi = (resiEl ? resiEl.innerText.trim() : '');
                    var companyName = (rootEl &amp;&amp; rootEl.getAttribute('data-company')) || 'Pengirim';
                    var url = window.location.href;
                    var text = 'Lacak status pengiriman paket ' + (resi &amp;&amp; resi !== 'Belum tersedia' ? 'No. Resi: ' + resi : '') + ' dari ' + companyName + ' melalui tautan resmi berikut: ' + url;
                    var waUrl = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(text);
                    window.open(waUrl, '_blank');
                }

                function dtdToggleItems() {
                    var container = document.getElementById('dtd_items_container');
                    var chevron = document.getElementById('dtd_items_chevron');
                    if (!container) return;
                    if (container.style.display === 'none') {
                        container.style.display = 'block';
                        if (chevron) {
                            chevron.classList.remove('fa-chevron-down');
                            chevron.classList.add('fa-chevron-up');
                        }
                    } else {
                        container.style.display = 'none';
                        if (chevron) {
                            chevron.classList.remove('fa-chevron-up');
                            chevron.classList.add('fa-chevron-down');
                        }
                    }
                }
            </script>
        </t>
    </template>

