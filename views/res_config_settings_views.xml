<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_delivery_tracking" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.delivery.tracking</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')][@data-key='stock']//h2[hasclass('mt32')][string()='Warehouse']" position="before">
                <h2>Delivery Tracking (Biteship)</h2>
                <div class="row mt16 o_settings_container" id="delivery_tracking_setting">
                    <div class="col-12 col-lg-6 o_setting_box" id="delivery_tracking_cron_setting">
                        <div class="o_setting_left_pane">
                            <field name="delivery_tracking_auto_track_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="delivery_tracking_auto_track_enabled"/>
                            <div class="text-muted">
                                Secara otomatis mengecek status pengiriman untuk
                                Delivery Order berstatus Done yang memiliki nomor resi.
                            </div>
                            <div class="content-group" id="delivery_tracking_cron_content"
                                 attrs="{'invisible': [('delivery_tracking_auto_track_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label string="Batch size per run"
                                           for="delivery_tracking_cron_batch_size"
                                           class="col-3"/>
                                    <field name="delivery_tracking_cron_batch_size"
                                           class="col-3"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="delivery_tracking_telegram_notify">
                        <div class="o_setting_left_pane">
                            <field name="delivery_tracking_notify_sales_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="delivery_tracking_notify_sales_enabled"/>
                            <div class="text-muted">
                                Kirim notifikasi Telegram ke salesperson saat
                                nomor resi diinput pada Delivery Order.
                            </div>
                            <div class="content-group" id="delivery_tracking_telegram_notify_content"
                                 attrs="{'invisible': [('delivery_tracking_notify_sales_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label string="Telegram Bot Token"
                                           for="delivery_tracking_telegram_bot_token"
                                           class="col-4"/>
                                    <field name="delivery_tracking_telegram_bot_token"
                                           password="True"
                                           class="col-8"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
