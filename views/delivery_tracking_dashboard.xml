<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =========================================================
         SEARCH VIEW  (dashboard-specific, extends the Fase 4
         search view so it inherits the status filters/group-by)
         ========================================================= -->
    <record id="view_picking_search_delivery_tracking_dashboard" model="ir.ui.view">
        <field name="name">stock.picking.search.delivery.tracking.dashboard</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock_picking_delivery_tracking.view_picking_search_delivery_tracking"/>
        <field name="arch" type="xml">
            <!-- 90-day window default filter (based on actual delivery date) -->
            <xpath expr="//filter[@name='dt_unknown']" position="after">
                <filter string="90 Hari Terakhir" name="dt_last_90_days"
                        domain="[('date_done', '&gt;=', (context_today() - datetime.timedelta(days=90)).strftime('%Y-%m-%d'))]"
                        help="Only show deliveries validated within the last 90 days"/>
            </xpath>
        </field>
    </record>

    <!-- =========================================================
         KANBAN VIEW  (standalone, group by delivery_tracking_status)
         ========================================================= -->
    <record id="view_picking_delivery_tracking_kanban" model="ir.ui.view">
        <field name="name">stock.picking.delivery.tracking.kanban</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="delivery_tracking_status" group_create="false" group_delete="false">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="carrier_id"/>
                <field name="carrier_tracking_ref"/>
                <field name="delivery_last_check"/>
                <field name="delivery_tracking_status"/>
                <field name="delivery_tracking_status_desc"/>
                <field name="delivery_tracking_error"/>
                <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                        <div class="o_kanban_record_top mb8">
                            <div class="o_kanban_record_headings ms-1">
                                <strong class="o_kanban_record_title">
                                    <span><t t-esc="record.name.value"/></span>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <span t-if="record.partner_id.raw_value">
                                        <i class="fa fa-user-o" title="Customer"/> <t t-esc="record.partner_id.value"/>
                                    </span>
                                    <br/>
                                    <span t-if="record.carrier_id.raw_value">
                                        <i class="fa fa-truck" title="Courier"/> <t t-esc="record.carrier_id.value"/>
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_image">
                                <field name="delivery_tracking_status" widget="badge"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span class="o_kanban_record_title">
                                    <i class="fa fa-hashtag" title="Resi"/> <t t-esc="record.carrier_tracking_ref.value or '—'"/>
                                </span>
                                <br/>
                                <span class="text-muted">
                                    <t t-if="record.delivery_last_check.value">
                                        <i class="fa fa-clock-o"/> Last check: <t t-esc="record.delivery_last_check.value"/>
                                    </t>
                                    <t t-else="">Belum pernah di-check</t>
                                </span>
                            </div>
                            <div t-if="record.delivery_tracking_status_desc.value"
                                 class="oe_kanban_bottom_right text-truncate text-muted"
                                 title="Status description">
                                <t t-esc="record.delivery_tracking_status_desc.value"/>
                            </div>
                            <div t-if="record.delivery_tracking_error.value"
                                 class="oe_kanban_bottom_right text-danger"
                                 title="Tracking error">
                                <i class="fa fa-exclamation-triangle"/> <t t-esc="record.delivery_tracking_error.value"/>
                            </div>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <!-- =========================================================
         PIVOT VIEW
         ========================================================= -->
    <record id="view_picking_delivery_tracking_pivot" model="ir.ui.view">
        <field name="name">stock.picking.delivery.tracking.pivot</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot string="Delivery Tracking" sample="1">
                <field name="carrier_id" type="row"/>
                <field name="delivery_tracking_status" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- =========================================================
         GRAPH VIEW  (bar)
         ========================================================= -->
    <record id="view_picking_delivery_tracking_graph" model="ir.ui.view">
        <field name="name">stock.picking.delivery.tracking.graph</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <graph string="Delivery Tracking" type="bar" sample="1">
                <field name="delivery_tracking_status"/>
            </graph>
        </field>
    </record>

    <!-- =========================================================
         ACTION  (kanban + pivot + graph + list)
         ========================================================= -->
    <record id="action_delivery_tracking_dashboard" model="ir.actions.act_window">
        <field name="name">Delivery Tracking Dashboard</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">kanban,pivot,graph,list,form</field>
        <field name="domain">[('picking_type_code', '=', 'outgoing'), ('carrier_tracking_ref', '!=', False)]</field>
        <field name="search_view_id" ref="view_picking_search_delivery_tracking_dashboard"/>
        <field name="view_id" ref="view_picking_delivery_tracking_kanban"/>
        <field name="context">{'search_default_group_by_delivery_status': 1, 'search_default_dt_last_90_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Pantau status pengiriman Delivery Order Anda di sini.
            </p>
            <p>
                Dashboard menampilkan Delivery Order (outgoing) yang memiliki nomor
                resi, dikelompokkan per status pengiriman. Gunakan tombol
                "Refresh Status Terpilih" untuk memperbarui status secara massal.
            </p>
        </field>
    </record>

    <!-- =========================================================
         MENU  (Inventory > Reporting)
         ========================================================= -->
    <menuitem id="menu_delivery_tracking_dashboard"
              name="Delivery Tracking Dashboard"
              parent="stock.menu_warehouse_report"
              action="action_delivery_tracking_dashboard"
              sequence="50"
              groups="stock.group_stock_manager,stock.group_stock_user"/>

    <!-- =========================================================
         SERVER ACTION  (bulk refresh, bound to list/kanban)
         ========================================================= -->
    <record id="action_refresh_selected_delivery_status" model="ir.actions.server">
        <field name="name">Refresh Status Terpilih</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,kanban</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_refresh_selected_delivery_status()
        </field>
    </record>

</odoo>
