<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_product_delivery_jntcargo" model="product.product">
            <field name="name">J&amp;T Cargo Delivery</field>
            <field name="default_code">DELIV_JNTCARGO</field>
            <field name="type">service</field>
            <field name="categ_id" ref="delivery.product_category_deliveries"/>
